/*
 * Formae Plugin Manifest
 *
 * This file defines metadata for your Formae plugin.
 * Update the values below to match your plugin.
 */

// TODO: Change to your plugin name (lowercase, letters/numbers/hyphens)
name = "atlas"

// TODO: Update version following semver
version = "0.1.0"

// TODO: Resource type namespace prefix (uppercase)
// This appears in resource types: ATLAS::Service::Resource
namespace = "ATLAS"

// One-line summary shown in `formae plugin list/info` output
summary = "Database schema migrations as a first-class formae resource (via Atlas)"

// TODO: Describe what your plugin does
description = "Manages database schema migrations via Atlas (atlasgo.io), modelling them as Atlas::Schema::Migration formae resources."

// TODO: Category for the plugin directory listing.
// Common values: "cloud", "network", "config", "observability", "auth", "other"
category = "data"

// TODO: Your license (SPDX identifier)
license = "Apache-2.0"

// Auto-generated by 'make build' from SDK. Do not edit manually.
minFormaeVersion = "0.84.0"

output {
  renderer = new JsonRenderer {}
}
