/*
 * Conformance Test: ATLAS::Schema::Migration — in-place update
 *
 * Mutates allowDowngrade (a mutable property). The DB state doesn't
 * change but the resource's properties do; the agent should patch
 * in place without replacement.
 */
amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@atlas/atlas.pkl"
import "@atlas/schema/migration.pkl"

local stackName = "plugin-sdk-test-stack"
local testRunID = read("env:FORMAE_TEST_RUN_ID")
local pluginRoot = read?("env:FORMAE_PLUGIN_ROOT") ?? read("env:PWD")

local atlasStack = new formae.Stack {
  label = stackName
  description = "Atlas plugin conformance test stack"
}

local atlasTarget = new formae.Target {
  label = "atlas-conformance-target"
  namespace = "ATLAS"
  config = new atlas.Config {
    dialect  = "postgres"
    host     = "127.0.0.1"
    port     = 5499
    database = "conformance"
    sslMode  = "disable"
    credentials = new atlas.UsernamePasswordCredentials {
      username = "postgres"
      password = "conformance"
    }
  }
}

forma {
  atlasStack
  atlasTarget
  new migration.Migration {
    stack         = atlasStack.res
    label         = "atlas-conformance-mig-\(testRunID)"
    target        = atlasTarget.res
    migrationsUri = "file://\(pluginRoot)/testdata/migrations/v1"
    targetVersion = "latest"
    allowDowngrade = true     // CHANGED — toggles a mutable field
  }
}
